# Build output
/build/
/out/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/*.sln
/*.vcxproj*

# Downloaded dependencies
/external/

# Runtime files that should not be committed
*.dll
*.exe
*.pdb
*.obj
*.ilk
*.lib
*.exp

# The NR runtime (nr-runtime/nvngx_dlssnr.dll, ~165 MB) stays out of git:
# it exceeds GitHub's 100 MB hard file limit. Supply it by hand or via
# build.ps1 -DlssnrDll (see nr-runtime/README.md).
*.addon64
ReShade.ini
ReShadePreset.ini
SmackMyRezUp.ini
SmackMyRezUp.log
SmackMyRezUpExport.log
ReShade.log

# Local archives / release bundles / generated checksums
/release/
*.zip
*.7z
*.rar
*.sha256
*_SHA256.txt

# IDE / OS
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
.DS_Store

# Python tool caches
__pycache__/
*.pyc

# desloppify local state
.desloppify/
.claude/
# TensorRT engine cache (machine-specific, built on first use)
/engines/

# Model weights the Python tools download beside the exe (HF_HOME/TORCH_HOME)
models/
